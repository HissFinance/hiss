exports[`§24.4 golden — PLAIN (ASCII-ish, stable labels) > vault.prepare-create.refused 1`] = `
"Refusing to prepare: manifest INVALID (8 issue(s)).
  CHAIN_NOT_ROBINHOOD @ chainId: Vault chain must be Robinhood Chain (4663 or 46630). Base is never a vault chain.
  BASE_ASSET_INVALID @ baseAsset: Base asset must be USDG.
  ALLOWED_ASSETS_INVALID @ allowedAssets: allowedAssets must be a non-empty array of source-verified asset symbols.
  FEE_OUT_OF_BOUNDS @ fees.managementBps: fees.managementBps must be an integer bps in [0, 500].
  FEE_MISSING @ fees.performanceBps: fees.performanceBps is required.
  CREATOR_ADDRESS_INVALID @ creator.address: creator.address must be a 0x-prefixed 20-byte address.
  CREATOR_SKIN_REQUIRED @ creator.skinInGameUsdg: creator.skinInGameUsdg must be greater than 0 (creator skin-in-the-game is mandatory).
  REBALANCE_FUSES_REQUIRED @ rebalance.fuses: rebalance.fuses is required.
"
`;

