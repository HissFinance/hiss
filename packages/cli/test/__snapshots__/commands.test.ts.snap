exports[`§24.4 golden — HUMAN (no color, Unicode components) > agentic.coils 1`] = `
"Coils compile deterministically to plans. Use \`hiss coil validate\` then \`hiss coil compile\`.
Coil execution modes
Mode:    paper_only
Meaning: research/backtest posture — nothing leaves the machine
State:   paper

Mode:    preview_only
Meaning: compile + preview an intent — no order path
State:   info

Mode:    human_confirm
Meaning: prepared intents require explicit human confirmation
State:   ready

Mode:    agentic_mcp_enabled
Meaning: user-side MCP execution posture (user runtime only)
State:   info
┌───────────────────────────────────────────────────────────────────────────────
│ A compiled coil is a plan (a hash), not an order. Fuses are binding and may   
│ never be bypassed.                                                            
└───────────────────────────────────────────────────────────────────────────────
"
`;

exports[`§24.4 golden — HUMAN (no color, Unicode components) > agentic.grants 1`] = `
"Capability families are declared, not active — this CLI grants read + prepare only, never execution.
Capability families
Family             Meaning                                       State   
─────────────────────────────────────────────────────────────────────────
read.protocol      read chain + protocol state                   ready   
read.vaults        read vault state, holdings, performance       ready   
prepare.vault      build UNSIGNED vault create/deposit/withdraw  prepared
prepare.stake      build UNSIGNED xHISS stake/cooldown/redeem    prepared
coil.compile       compile coil plans locally (deterministic)    ready   
execute.brokerage  place brokerage orders                        blocked 
┌───────────────────────────────────────────────────────────────────────────────
│ This CLI exposes read + prepare families only.                                
│ execute.brokerage is never granted by HISS; it belongs to your own RH Trading 
│ MCP runtime.                                                                  
└───────────────────────────────────────────────────────────────────────────────
"
`;

exports[`§24.4 golden — HUMAN (no color, Unicode components) > agentic.receipts 1`] = `
"Verify a receipt's integrity locally with \`hiss receipt verify\` — a missing stage is never implied as done.
compilation — a coil/intent is compiled to a deterministic plan hash
authorization — the plan is authorized by its policy/fuses (still a plan)
submission — a stage that only YOUR wallet/runtime can perform
settlement — recorded only from a verified on-chain receipt
reconciliation — settlement reconciled against the plan
┌───────────────────────────────────────────────────────────────────────────────
│ Verify a receipt's integrity with \`hiss receipt verify\`.                      
│ A stage without proof is shown as pending — never implied to have occurred.   
└───────────────────────────────────────────────────────────────────────────────
"
`;

exports[`§24.4 golden — HUMAN (no color, Unicode components) > agentic.setup 1`] = `
"Agentic setup: connect the HISS MCP for read/prepare; run the RH Trading MCP in your own runtime.
1. Connect the HISS MCP (read + prepare): point your agent client at
https://mcp.hiss.finance/mcp.
2. Verify it with \`hiss mcp doctor\`.
3. For brokerage actions, run the Robinhood Trading MCP in YOUR OWN runtime and
follow its own auth flow.
4. HISS never brokers that credential — it only prepares unsigned chain
transactions for you to review.
┌─ No credential is ever requested ─────────────────────────────────────────────
│ HISS does not ask for, store, or forward any brokerage credential or private  
│ key.                                                                          
│ The Robinhood Trading MCP authenticates entirely inside your own agent        
│ runtime.                                                                      
└───────────────────────────────────────────────────────────────────────────────
"
`;

